<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_weight="1"
        android:padding="20dp">

        <Button
            android:id="@+id/btnUpload"
            android:text="@string/upload_syllabus_pdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/delete_btn_text"/>

        <Button
            android:id="@+id/btnTranscript"
            android:text="@string/upload_transcript_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/delete_btn_text"/>


        <Button
            android:id="@+id/btnExtract"
            android:text="@string/extract_skills"
            android:enabled="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/delete_btn_text"/>
        <Button
            android:id="@+id/btnTop5"
            android:text="@string/top_5_internships"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/delete_btn_text"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp">

            <TableLayout
                android:id="@+id/tableSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1"/>
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Navigation -->
<!--    <com.google.android.material.bottomnavigation.BottomNavigationView-->
<!--        android:id="@+id/bottomNav"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:background="@color/white"-->
<!--        app:menu="@menu/menu_bottom" />-->
</LinearLayout>
