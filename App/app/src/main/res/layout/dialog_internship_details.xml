<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- BACKGROUND THAT MATCHES CONTENT HEIGHT BUT NEVER LESS THAN SCREEN -->
    <ImageView
        android:id="@+id/fixedBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_detail"
        android:alpha="0.3" />

    <!-- SCROLL CONTENT BUT FORCE MIN HEIGHT = SCREEN -->
    <ScrollView
        android:id="@+id/dialogScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- Image -->
            <ImageView
                android:id="@+id/imgInternshipDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:src="@drawable/ic_image"
                android:layout_gravity="center" />

            <!-- Internship Name -->
            <TextView
                android:id="@+id/tvDialogName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_marginTop="12dp" />

            <!-- Company Name -->
            <TextView
                android:id="@+id/tvDialogCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#555"
                android:layout_marginTop="4dp" />

            <!-- Type -->
            <TextView
                android:id="@+id/tvDialogType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="italic"
                android:textColor="#777"
                android:layout_marginTop="4dp" />

            <!-- Rating -->
            <TextView
                android:id="@+id/tvDialogRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333"
                android:layout_marginTop="6dp" />

            <!-- Dates -->
            <TextView
                android:id="@+id/tvDialogDates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333"
                android:layout_marginTop="6dp" />

            <!-- Slots -->
            <TextView
                android:id="@+id/tvDialogSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#333"
                android:layout_marginTop="6dp" />

            <!-- Created at -->
            <TextView
                android:id="@+id/tvDialogCreated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#888"
                android:layout_marginTop="4dp" />

            <!-- Description -->
            <TextView
                android:id="@+id/tvDialogDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#000"
                android:layout_marginTop="12dp" />

            <!-- CV Upload Card -->
            <LinearLayout
                android:id="@+id/layoutCvUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/professional_rounded_box"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_upload"
                    android:tint="@color/soft_gold"
                    android:contentDescription="CV PDF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvCvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Attach your CV (PDF)"
                        android:textStyle="bold"
                        android:textColor="#000"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvCvFileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No file selected"
                        android:textColor="#555"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnPickCv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/rich_gold"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <!-- Apply Button -->
            <Button
                android:id="@+id/btnDialogApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apply"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/rich_gold"
                android:textColor="@android:color/white" />
        </LinearLayout>

    </ScrollView>

</FrameLayout>
