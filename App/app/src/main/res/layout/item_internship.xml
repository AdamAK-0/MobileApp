<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:cardBackgroundColor="@color/white"
    card_view:cardCornerRadius="15dp"
    card_view:cardElevation="5dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Internship Image -->
        <ImageView
            android:id="@+id/imgInternship"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_image"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <!-- Info Container -->
        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/imgInternship"
            android:layout_alignParentTop="true"
            android:layout_marginStart="16dp"
            android:layout_toStartOf="@id/layoutIcons">

            <TextView
                android:id="@+id/tvInternName"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/dark_charcoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvInternCompany"
                android:textSize="16sp"
                android:textColor="@color/dark_charcoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvInternType"
                android:textSize="14sp"
                android:textColor="@color/light_grey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/tvApplicationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Not applied"
                android:textSize="12sp"
                android:textColor="@color/light_grey"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Action Icons -->
        <LinearLayout
            android:id="@+id/layoutIcons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"><Button
    android:id="@+id/btnApply"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:text="Apply"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:textAllCaps="false"
    android:backgroundTint="@color/rich_gold"
    android:textColor="@android:color/white"
    android:visibility="gone" />


            <ImageView
                android:id="@+id/btnEdit"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_edit"
                android:contentDescription="Edit Internship"
                android:layout_marginEnd="16dp"
                card_view:tint="@color/soft_gold" />

            <ImageView
                android:id="@+id/btnDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_delete"
                android:contentDescription="Delete Internship"
                card_view:tint="@android:color/holo_red_dark" />
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>