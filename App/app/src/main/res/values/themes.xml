<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.Portin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/rich_gold</item>
        <item name="colorPrimaryVariant">@color/soft_gold</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/soft_gold</item>
        <item name="colorOnSecondary">@color/dark_charcoal</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/rich_gold</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>