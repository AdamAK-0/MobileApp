<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/portinicon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/portinicon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Portin">
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".HomeActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".AddInternshipActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".ProfileActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".CompanyApplicationsActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".SkillActivity"
            android:exported="false">
        </activity>
        <activity
            android:name=".BaseFragmentActivity"
            android:exported="false">
        </activity>
    </application>

</manifest>